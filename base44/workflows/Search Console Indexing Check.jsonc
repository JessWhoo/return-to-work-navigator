{
  "description": "Re-runs the Google Search Console inspection a few days after the sitemap was submitted and emails the indexing report to the app admin.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "one_time",
      "cron_expression": null,
      "one_time_date": "2026-10-18T15:00:00Z",
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Search Console Indexing Check",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "search_console_indexing_check",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "searchConsoleReport"
          },
          "then": "send_report",
          "x-base44": {
            "title": "Run Search Console report",
            "description": "Inspects key URLs"
          }
        }
      },
      {
        "send_report": {
          "call": "send_email",
          "with": {
            "template_name": "SearchConsoleIndexingReport",
            "to": "${ .run_report.adminEmail }",
            "subject": "Your Search Console indexing report is ready",
            "variables": {
              "site_url": "${ .run_report.siteUrl }",
              "verified": "${ .run_report.verified }",
              "sitemap_submitted": "${ .run_report.sitemaps.alreadySubmitted }",
              "indexed_count": "${ [(.run_report.inspections // [])[] | select(.verdict == \"PASS\")] | length }",
              "total_count": "${ (.run_report.inspections // []) | length }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email indexing report",
            "description": "Sends summary to admin"
          }
        }
      }
    ]
  }
}