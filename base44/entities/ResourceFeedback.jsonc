{
  "name": "ResourceFeedback",
  "type": "object",
  "properties": {
    "was_helpful": {
      "type": "boolean",
      "description": "Whether the user found the resource information helpful"
    },
    "topics_needing_support": {
      "type": "string",
      "maxLength": 1000,
      "description": "Topics the user wants more support or information on"
    },
    "page": {
      "type": "string",
      "description": "Page the feedback was submitted from"
    }
  },
  "required": [
    "was_helpful"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}