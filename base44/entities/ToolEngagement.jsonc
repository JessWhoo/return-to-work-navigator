{
  "name": "ToolEngagement",
  "type": "object",
  "properties": {
    "tool": {
      "type": "string",
      "enum": [
        "accommodation_letter_generator",
        "employer_email_generator",
        "legal_rights_advisor",
        "ai_coach"
      ],
      "description": "The tool that was engaged with"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional additional description or context for this tool engagement"
    }
  },
  "required": [
    "tool"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}